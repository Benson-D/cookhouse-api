PORT=4000
CORS_ORIGIN=http://localhost:3000

# Supabase Postgres — hosting only, Prisma is the ORM.
# Project Settings > Database > Connection string in the Supabase dashboard.
# DATABASE_URL: "Transaction pooler" (port 6543) — used by the app (Prisma Client) at runtime.
# DIRECT_URL:   "Direct connection" (port 5432) — used by Prisma Migrate to run migrations.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Clerk backend SDK — from the Clerk dashboard, used to verify session tokens
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

# ─── Object storage (recipe photos, receipt images) ───────────────────────
# Written against the S3 API, so any S3-compatible provider works. Only the
# four lines below differ between them.
#
# Cloudflare R2:
#   STORAGE_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#   STORAGE_REGION=auto
#   keys from R2 > Manage API Tokens
#
# AWS S3:
#   leave STORAGE_ENDPOINT empty (the SDK derives the AWS host)
#   STORAGE_REGION=us-east-2   (your bucket's real region)
#   keys from an IAM user limited to this bucket
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=

# Optional. Set when the bucket is served publicly, so images render from a
# CDN instead of an expiring presigned URL:
#   R2 with a custom domain -> https://images.yourdomain.com
#   S3 behind CloudFront    -> https://d111111abcdef8.cloudfront.net
# Leave empty and reads fall back to short-lived presigned GET URLs.
STORAGE_PUBLIC_URL=

# ─── Demo fixtures (pnpm db:seed:demo) — local development only ───────────
# Household rows key on clerkOrgId, which is not a local FK, so fixtures
# seeded against an invented id are invisible to every signed-in user. Use the
# real ids from Clerk:  clerk api /organizations   and   clerk api /users
DEMO_CLERK_ORG_ID=
DEMO_CLERK_USER_ID=
