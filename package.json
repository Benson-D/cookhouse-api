{
  "name": "cookhouse-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.3.0",
  "engines": {
    "node": "^20.19 || ^22.12 || >=24.0"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "db:seed:demo:clean": "tsx prisma/seed-demo.ts --clean",
    "build:contract": "node contract/build.mjs",
    "backfill:categories": "tsx scripts/backfill-categories.ts",
    "cleanup:remove-count-unit": "tsx scripts/remove-count-unit.ts",
    "seed:ingredients-from-dictionary": "tsx scripts/seed-ingredients-from-dictionary.ts",
    "stores:list": "tsx scripts/list-stores.ts",
    "stores:merge": "tsx scripts/merge-store.ts",
    "seed:known-stores": "tsx scripts/seed-known-stores.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1130.0",
    "@aws-sdk/client-textract": "^3.1133.0",
    "@aws-sdk/s3-request-presigner": "^3.1130.0",
    "@clerk/backend": "^1.18.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.9.1",
    "@trpc/server": "^11.0.0-rc.502",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "jpeg-js": "^0.4.4",
    "libheif-js": "^1.23.2",
    "morgan": "^1.12.1",
    "pg": "^8.13.0",
    "rate-limiter-flexible": "^11.2.0",
    "resend": "^6.28.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.5.0",
    "@types/pg": "^8.11.10",
    "dts-bundle-generator": "^9.5.1",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.5.4",
    "vitest": "^5.0.1",
    "vitest-mock-extended": "^5.1.1"
  },
  "pnpm": {
    "overrides": {
      "deepmerge-ts": ">=8.0.0"
    }
  }
}
